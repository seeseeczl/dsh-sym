{
  "name": "dsh-sym",
  "version": "1.8.2",
  "description": "给 DeepSeek Harness 的界面读数层：输入框状态栏的实时会话花费（人民币、按实际厂商/模型与峰谷时段折算）、输入框工具行里模型选择器左侧的 DeepSeek 账户余额、品牌行的峰谷时段标记、把任意一条回复作为上下文引用的 @ 按钮、侧栏右缝里可自定义的快捷按钮条（含设置页），以及侧栏会话菜单里的「复制会话 ID / 导出会话日志」。",
  "license": "MIT",
  "type": "module",
  "main": "lib/host-v19.js",
  "exports": {
    ".": {
      "default": "./lib/host-v19.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/host-v19.js",
    "lib/client.js",
    "lib/prices.json",
    "test",
    "scripts",
    "cordis.patch.yml",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "PUBLISHING.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek",
    "deepseek-harness",
    "cost",
    "billing",
    "usage",
    "balance",
    "token",
    "pricing",
    "hud"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seeseeczl/dsh-sym.git"
  },
  "homepage": "https://github.com/seeseeczl/dsh-sym#readme",
  "bugs": {
    "url": "https://github.com/seeseeczl/dsh-sym/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check-invariants.mjs",
    "verify:loss": "node scripts/verify-context-loss.mjs",
    "check:pack": "node scripts/check-package.mjs"
  }
}
